---
import { getCollection, render } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import CTABand from "../../components/sections/CTABand.astro";
import PostCard from "../../components/ui/PostCard.astro";
import { withBase } from "../../utils/paths";
import { readingMinutes, readingTime, wordCount } from "../../utils/reading";
import { blogNode, blogPosting } from "../../utils/schema";

export async function getStaticPaths() {
  const posts = await getCollection("blog");
  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await render(post);
const { title, description, category, pubDate, draft } = post.data;

const readTime = post.data.readTime ?? readingTime(post.body);

const formattedDate = pubDate.toLocaleDateString("en-US", {
  month: "long",
  day: "numeric",
  year: "numeric",
  timeZone: "UTC",
});

const siteUrl = Astro.site ?? new URL("https://www.ursamajorglobaltech.com");
// The Blog node is declared here too, not just on /blog/. The post's
// `isPartOf` has to resolve within this page's own graph.
const schema = [
  blogNode(siteUrl),
  blogPosting({
    post,
    site: siteUrl,
    wordCount: wordCount(post.body),
    readingMinutes: readingMinutes(post.body),
  }),
];

const related = (await getCollection("blog"))
  .filter((entry) => entry.id !== post.id && !entry.data.draft)
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 3);
---

<BaseLayout
  title={`${title} | Ursa Major Global Tech`}
  description={description}
  canonicalPath={`/blog/${post.id}/`}
  pageName={title}
  schema={schema}
  ogType="article"
  noindex={draft}
>
  <article class="post-page">
    <div class="container container--narrow">
      <a href={withBase("/blog/")} class="post-page__back" data-animate="fade">
        ← Back to All Posts
      </a>

      <header class="post-page__header">
        <p class="eyebrow" data-animate="fade">{category}</p>
        <h1 data-split="lines">{title}</h1>
        <div class="post-page__meta" data-animate="fade" data-animate-delay="0.3">
          <span>{formattedDate}</span>
          <span aria-hidden="true">·</span>
          <span>{readTime}</span>
        </div>
      </header>

      <div class="prose" data-animate="fade-up" data-animate-delay="0.2">
        <Content />
      </div>
    </div>
  </article>

  <section class="section">
    <div class="container">
      <header class="section-header">
        <p class="eyebrow" data-animate="fade">Keep Reading</p>
        <h2 data-animate="fade-up">More from the workshop</h2>
      </header>
      <div class="post-page__related" data-animate-children>
        {related.map((entry) => <PostCard post={entry} />)}
      </div>
    </div>
  </section>

  <CTABand />
</BaseLayout>

<style lang="scss">
  .post-page {
    padding-block: calc(var(--header-height) + var(--space-xl)) var(--space-2xl);
  }

  .post-page__back {
    display: inline-block;
    margin-bottom: var(--space-lg);
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    color: var(--color-text-muted);

    &:hover {
      color: var(--peri-300);
    }
  }

  .post-page__header {
    display: flex;
    flex-direction: column;
    gap: var(--space-sm);
    margin-bottom: var(--space-xl);
    padding-bottom: var(--space-lg);
    border-bottom: 1px solid var(--color-border);

    h1 {
      font-size: var(--text-2xl);
    }
  }

  .post-page__meta {
    display: flex;
    gap: 0.625rem;
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    color: var(--color-text-subtle);
  }

  .post-page__related {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--space-md);
  }

  @media (max-width: 960px) {
    .post-page__related {
      grid-template-columns: 1fr;
      max-width: 26rem;
    }
  }
</style>
