---
import { getCollection, render } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import CTABand from "../../components/sections/CTABand.astro";
import PriceTag from "../../components/ui/PriceTag.astro";
import BuyButton from "../../components/ui/BuyButton.astro";
import { withBase } from "../../utils/paths";
import { advisoryOffer, faqPage } from "../../utils/schema";

export async function getStaticPaths() {
  const offers = await getCollection("offers");
  return offers
    .filter((offer) => offer.data.family === "advisory" && !offer.data.draft)
    .map((offer) => ({ params: { slug: offer.id }, props: { offer } }));
}

const { offer } = Astro.props;
const { Content } = await render(offer);
const d = offer.data;

const currency = new Intl.NumberFormat("en-US", {
  style: "currency",
  currency: "USD",
  maximumFractionDigits: 0,
});

// Emitted regardless of `published`, so the structured data goes live the
// moment the page's checkout and intake URLs do. `priceGate` still withholds
// the figure: advisoryOffer only carries a price the page itself prints.
const siteUrl = Astro.site ?? new URL("https://www.ursamajorglobaltech.com");
const path = `/advisory/${offer.id}/`;
const schema = [
  advisoryOffer(offer, siteUrl),
  d.question &&
    faqPage(
      [{ question: d.question, answer: d.answer ?? d.summary }],
      siteUrl,
      path,
    ),
];
---

<BaseLayout
  title={`${d.title} | Ursa Major Global Tech`}
  description={d.summary}
  canonicalPath={path}
  pageName={d.title}
  schema={schema}
  ogType="article"
>
  <article class="offer">
    <div class="container">
      <a href={withBase("/advisory/")} class="offer__back" data-animate="fade">
        ← Back to Advisory
      </a>

      <header class="offer__header">
        {d.kicker && <p class="eyebrow" data-animate="fade">{d.kicker}</p>}
        <h1 data-split="lines">{d.title}</h1>
        <p class="lead" data-animate="fade-up" data-animate-delay="0.3">{d.summary}</p>

        <div class="offer__buy" data-animate="fade-up" data-animate-delay="0.4">
          <div class="offer__price">
            <PriceTag pricing={d.pricing} gated={d.priceGate} size="lg" />
            {d.timeline && <p class="offer__timeline">{d.timeline}</p>}
          </div>
          <BuyButton buying={d.buying} published={d.published} size="lg" />
        </div>

        {d.forWho && (
          <p class="offer__forwho" data-animate="fade-up" data-animate-delay="0.5">
            <span>Who it's for</span>
            {d.forWho}
          </p>
        )}
      </header>

      <div class="offer__layout">
        <div class="offer__main">
          <section class="prose" data-animate="fade-up">
            <Content />
          </section>

          {
            d.process.length > 0 && (
              <section data-animate="fade-up">
                <h2 class="offer__h2">How it runs</h2>
                <ol class="offer__process">
                  {d.process.map((phase, i) => (
                    <li>
                      <span class="offer__process-num">0{i + 1}</span>
                      <h3>{phase.step}</h3>
                      <p>{phase.detail}</p>
                    </li>
                  ))}
                </ol>
              </section>
            )
          }

          {
            d.deliverables.length > 0 && (
              <section data-animate="fade-up">
                <h2 class="offer__h2">What you get</h2>
                <ul class="checklist">
                  {d.deliverables.map((item) => (
                    <li>{item}</li>
                  ))}
                </ul>
              </section>
            )
          }

          {
            d.notFor.length > 0 && (
              <section data-animate="fade-up">
                <h2 class="offer__h2">What it is not</h2>
                <ul class="offer__not">
                  {d.notFor.map((item) => (
                    <li>{item}</li>
                  ))}
                </ul>
              </section>
            )
          }

          {
            d.exclusions.length > 0 && (
              <section data-animate="fade-up">
                <h2 class="offer__h2">Not included</h2>
                <p class="offer__note">
                  Stated here rather than in fine print, so scope expansion is a
                  line item and never an argument.
                </p>
                <ul class="offer__not">
                  {d.exclusions.map((item) => (
                    <li>{item}</li>
                  ))}
                </ul>
              </section>
            )
          }

          {
            d.addOns.length > 0 && (
              <section data-animate="fade-up">
                <h2 class="offer__h2">Add-ons</h2>
                <p class="offer__note">Published prices. The call selects scope plus add-ons.</p>
                <ul class="offer__addons">
                  {d.addOns.map((addOn) => (
                    <li>
                      <span>
                        {addOn.label}
                        {addOn.note && <em> ({addOn.note})</em>}
                      </span>
                      <b>{currency.format(addOn.amount)}</b>
                    </li>
                  ))}
                </ul>
              </section>
            )
          }
        </div>

        <aside class="offer__aside">
          {
            d.scope.length > 0 && (
              <div class="offer__panel" data-animate="fade-up">
                <h2>Fixed scope</h2>
                <dl class="offer__scope">
                  {d.scope.map((line) => (
                    <div>
                      <dt>{line.label}</dt>
                      <dd>{line.value}</dd>
                    </div>
                  ))}
                </dl>
              </div>
            )
          }

          {
            d.revisionCap && (
              <div class="offer__panel" data-animate="fade-up">
                <h2>Revisions</h2>
                <p>{d.revisionCap}</p>
              </div>
            )
          }

          {
            d.creditMechanic && (
              <div class="offer__panel offer__panel--credit" data-animate="fade-up">
                <h2>Credit</h2>
                <p>{d.creditMechanic}</p>
              </div>
            )
          }

          {
            d.exitArtifact && (
              <div class="offer__panel" data-animate="fade-up">
                <h2>What comes next</h2>
                <p>{d.exitArtifact}</p>
              </div>
            )
          }
        </aside>
      </div>
    </div>
  </article>

  <CTABand
    title="Ready when you are"
    copy="Bring the decision you're trying to make. We'll tell you which step fits, or that you don't need one yet."
  />
</BaseLayout>

<style lang="scss">
  .offer {
    padding-block: calc(var(--header-height) + var(--space-xl)) var(--space-2xl);
  }

  .offer__back {
    display: inline-block;
    margin-bottom: var(--space-lg);
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    color: var(--color-text-muted);

    &:hover {
      color: var(--peri-300);
    }
  }

  .offer__header {
    display: flex;
    flex-direction: column;
    gap: var(--space-md);
    padding-bottom: var(--space-xl);
    border-bottom: 1px solid var(--color-border);
  }

  .offer__buy {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-end;
    gap: var(--space-lg);
    margin-top: var(--space-xs);
  }

  .offer__price {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
  }

  .offer__timeline {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--color-text-subtle);
  }

  .offer__forwho {
    display: flex;
    flex-direction: column;
    gap: 0.375rem;
    max-width: 46rem;
    padding: var(--space-md);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    background: var(--ink-850);
    font-size: var(--text-sm);
    color: var(--color-text);
    line-height: 1.65;

    span {
      font-family: var(--font-mono);
      font-size: var(--text-xs);
      letter-spacing: 0.16em;
      text-transform: uppercase;
      color: var(--peri-400);
    }
  }

  .offer__layout {
    display: grid;
    grid-template-columns: minmax(0, 1.7fr) minmax(0, 1fr);
    gap: var(--space-2xl);
    margin-top: var(--space-xl);
    align-items: start;
  }

  .offer__main {
    display: flex;
    flex-direction: column;
    gap: var(--space-xl);
    min-width: 0;
  }

  .offer__h2 {
    font-size: var(--text-lg);
    margin-bottom: var(--space-md);
  }

  .offer__note {
    margin-top: -0.75rem;
    margin-bottom: var(--space-md);
    font-size: var(--text-sm);
    color: var(--color-text-subtle);
    max-width: 46ch;
  }

  .offer__process {
    list-style: none;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: var(--space-md);

    li {
      padding-left: var(--space-md);
      border-left: 1px solid var(--color-border-accent);
    }

    h3 {
      font-size: var(--text-base);
      margin-block: 0.25rem;
    }

    p {
      font-size: var(--text-sm);
      color: var(--color-text-muted);
      line-height: 1.65;
    }
  }

  .offer__process-num {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    color: var(--peri-400);
  }

  .offer__not {
    list-style: none;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 0.625rem;

    li {
      position: relative;
      padding-left: 1.5rem;
      font-size: var(--text-sm);
      color: var(--color-text-muted);
      line-height: 1.6;

      &::before {
        content: "-";
        position: absolute;
        left: 0;
        color: var(--color-text-subtle);
      }
    }
  }

  .offer__addons {
    list-style: none;
    padding: 0;
    display: flex;
    flex-direction: column;

    li {
      display: flex;
      justify-content: space-between;
      align-items: baseline;
      gap: var(--space-md);
      padding-block: 0.75rem;
      border-bottom: 1px solid var(--color-border);
      font-size: var(--text-sm);
      color: var(--color-text);

      &:last-child {
        border-bottom: none;
      }

      em {
        color: var(--color-text-subtle);
        font-style: normal;
      }

      b {
        font-family: var(--font-mono);
        font-weight: 500;
        color: var(--color-text-strong);
        white-space: nowrap;
      }
    }
  }

  .offer__aside {
    display: flex;
    flex-direction: column;
    gap: var(--space-md);
    position: sticky;
    top: calc(var(--header-height) + var(--space-md));
  }

  .offer__panel {
    padding: var(--space-md);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    background: var(--ink-850);

    h2 {
      font-family: var(--font-mono);
      font-size: var(--text-xs);
      font-weight: 500;
      letter-spacing: 0.18em;
      text-transform: uppercase;
      color: var(--peri-400);
      margin-bottom: var(--space-sm);
    }

    p {
      font-size: var(--text-sm);
      color: var(--color-text-muted);
      line-height: 1.65;
    }
  }

  .offer__panel--credit {
    border-color: rgba(52, 211, 153, 0.3);
    background: rgba(52, 211, 153, 0.06);

    h2 {
      color: var(--color-positive);
    }

    p {
      color: var(--color-text);
    }
  }

  .offer__scope {
    display: flex;
    flex-direction: column;
    gap: 0.625rem;
    margin: 0;

    div {
      display: flex;
      justify-content: space-between;
      gap: var(--space-sm);
      font-size: var(--text-sm);
    }

    dt {
      color: var(--color-text-subtle);
    }

    dd {
      margin: 0;
      text-align: right;
      color: var(--color-text-strong);
    }
  }

  @media (max-width: 900px) {
    .offer__layout {
      grid-template-columns: 1fr;
      gap: var(--space-xl);
    }

    .offer__aside {
      position: static;
    }
  }
</style>
