---
import BaseLayout from "../../layouts/BaseLayout.astro";
import PageHero from "../../components/sections/PageHero.astro";
import CTABand from "../../components/sections/CTABand.astro";
import AdvisoryDesk from "../../components/sections/AdvisoryDesk.astro";
import PriceTag from "../../components/ui/PriceTag.astro";
import { withBase } from "../../utils/paths";
import { getAdvisorySteps } from "../../utils/offers";
import { advisoryCatalog, advisoryFaq } from "../../utils/schema";

const steps = await getAdvisorySteps();

const siteUrl = Astro.site ?? new URL("https://www.ursamajorglobaltech.com");
const schema = [
  advisoryCatalog(steps, siteUrl),
  advisoryFaq(steps, siteUrl, "/advisory/"),
];

// Row labels are written from the buyer's side of the table ("starts from",
// "your time", "what you get") rather than describing our method to us.
const COMPARISON = [
  { row: "Starts from", audit: "Your day-to-day processes", strategy: "Your business model" },
  { row: "Answers", audit: "What can we automate", strategy: "Where does AI change how we operate" },
  { row: "Who buys it", audit: "Owner or operator", strategy: "Executive team or board" },
  { row: "How long", audit: "1 week", strategy: "5–6 weeks" },
  { row: "Your time", audit: "75 minutes total", strategy: "12 interviews, 2 workshops, a readout" },
  { row: "What you get", audit: "A ranked, priced list of what to automate", strategy: "A written strategy and an executive presentation" },
];
---

<BaseLayout
  title="AI Advisory & Strategy Consulting | Ursa Major Global Tech"
  description="Fixed-price AI advisory, from a $2,500 opportunity audit to fractional AI leadership. Every price published, and the audit is free if you build with us."
  canonicalPath="/advisory/"
  pageName="Advisory"
  pageType="CollectionPage"
  schema={schema}
>

  <PageHero
    eyebrow="AI Advisory"
    title="Know what AI is worth to you before you build it"
    lead="Four ways to buy senior AI judgment, starting at $2,500 for a five-day opportunity audit. Every price is published, every exclusion is listed before you pay, and what you spend deciding credits toward what you build."
  />

  <section class="section section--flush-top">
    <div class="container">
      <header class="section-header">
        <p class="eyebrow" data-animate="fade">All four, priced</p>
        <h2 data-animate="fade-up">What AI advisory actually costs</h2>
      </header>

      <ol class="ladder" data-animate-children>
        {
          steps.map((offer) => (
            <li class="ladder__item">
              <a href={withBase(`/advisory/${offer.id}/`)} class="ladder__link">
                <div class="ladder__body">
                  {offer.data.category && (
                    <span class="ladder__category">{offer.data.category}</span>
                  )}
                  <h3 class="ladder__title">{offer.data.title}</h3>
                  <p class="ladder__summary">{offer.data.summary}</p>
                  {offer.data.forWho && <p class="ladder__for">{offer.data.forWho}</p>}
                </div>

                <div class="ladder__meta">
                  <PriceTag
                    pricing={offer.data.pricing}
                    gated={offer.data.priceGate}
                    size="sm"
                  />
                  {offer.data.timeline && (
                    <p class="ladder__timeline">{offer.data.timeline}</p>
                  )}
                  <span class="ladder__more">
                    Details <span aria-hidden="true">→</span>
                  </span>
                </div>
              </a>
            </li>
          ))
        }
      </ol>

      {/* The objection-killer for a cold $2,500 purchase. Every clause here is
          already in the content files (creditMechanic, exitArtifact). This
          promotes it out of a subordinate clause and does the arithmetic for
          the reader instead of leaving it to them. */}
      <div class="reversal" data-animate="fade-up">
        <h3 class="reversal__claim">If you build with us, the audit is free.</h3>
        <p class="reversal__body">
          The $2,500 Opportunity Audit credits back in full against any build over
          $10,000. If you don't build with us, you keep a document you own
          outright: process maps, a scored opportunity register, and a priced
          menu you can hand to any other firm. Either way, you're not paying for a
          sales presentation.
        </p>
      </div>
    </div>
  </section>

  <AdvisoryDesk />

  <section class="section">
    <div class="container container--narrow">
      <header class="section-header section-header--center">
        <p class="eyebrow" data-animate="fade">Choosing between the first two</p>
        <h2 data-animate="fade-up">The Audit is not a smaller Strategy Engagement</h2>
        <p class="lead" data-animate="fade-up" data-animate-delay="0.1">
          They answer different questions for different buyers. Picking the wrong
          one is the most expensive mistake on this page, so here they are side
          by side, and if you want the longer version, we wrote up
          <a href={withBase("/blog/ai-strategy-or-automation/")}>
            how to tell which one you need</a>.
        </p>
      </header>

      <div class="compare" data-animate="fade-up">
        <table>
          <thead>
            <tr>
              <th scope="col"><span class="visually-hidden">Dimension</span></th>
              <th scope="col">Opportunity Audit</th>
              <th scope="col">Strategy Engagement</th>
            </tr>
          </thead>
          <tbody>
            {
              COMPARISON.map((line) => (
                <tr>
                  <th scope="row">{line.row}</th>
                  <td>{line.audit}</td>
                  <td>{line.strategy}</td>
                </tr>
              ))
            }
          </tbody>
        </table>
      </div>
    </div>
  </section>

  <CTABand
    title="Not sure where to start?"
    copy="Tell us the decision you're trying to make and we'll point you in the right direction."
  />
</BaseLayout>

<style lang="scss">
  .ladder {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: var(--space-sm);
    counter-reset: ladder;
  }

  .ladder__link {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 14rem);
    gap: var(--space-lg);
    align-items: center;
    padding: var(--space-lg);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    background: linear-gradient(160deg, var(--ink-700) 0%, var(--ink-850) 65%);
    transition:
      border-color var(--transition-base),
      transform var(--transition-base),
      box-shadow var(--transition-base);

    &:hover {
      border-color: var(--color-border-accent);
      transform: translateY(-3px);
      box-shadow: var(--shadow-card), var(--glow-accent);
    }
  }

  /* Was a rotated "Step N" rail in its own grid column. The category that
     replaced it is far too long to set vertically, so it runs horizontally
     above the title instead, the same slot the homepage Ascent uses. */
  .ladder__category {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--peri-400);
  }

  .ladder__body {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    min-width: 0;
  }

  .ladder__title {
    font-size: var(--text-xl);
  }

  .ladder__summary {
    color: var(--color-text-muted);
    line-height: 1.6;
  }

  .ladder__for {
    font-size: var(--text-sm);
    color: var(--color-text-subtle);
    line-height: 1.6;
  }

  .ladder__meta {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    align-items: flex-start;
    padding-left: var(--space-lg);
    border-left: 1px solid var(--color-border);
  }

  .ladder__timeline {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-text-subtle);
  }

  .ladder__more {
    margin-top: 0.25rem;
    font-size: var(--text-sm);
    font-weight: 560;
    color: var(--peri-400);
  }

  /* ---------------------------------------------------------------- */
  .reversal {
    margin-top: var(--space-md);
    padding: var(--space-md) var(--space-lg);
    border: 1px solid rgba(52, 211, 153, 0.3);
    border-radius: var(--radius-lg);
    background: rgba(52, 211, 153, 0.06);
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .reversal__claim {
    font-size: var(--text-xl);
    color: var(--color-positive);
  }

  .reversal__body {
    font-size: var(--text-sm);
    line-height: 1.7;
    color: var(--color-text);
    max-width: 68ch;
    text-wrap: pretty;
  }

  /* ---------------------------------------------------------------- */
  .compare {
    overflow-x: auto;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    background: var(--ink-850);

    table {
      width: 100%;
      min-width: 40rem;
      border-collapse: collapse;
      text-align: left;
    }

    th,
    td {
      padding: var(--space-sm) var(--space-md);
      border-bottom: 1px solid var(--color-border);
      vertical-align: top;
    }

    thead th {
      font-family: var(--font-mono);
      font-size: var(--text-xs);
      font-weight: 500;
      letter-spacing: 0.14em;
      text-transform: uppercase;
      color: var(--peri-400);
    }

    tbody th {
      font-family: var(--font-mono);
      font-size: var(--text-xs);
      font-weight: 500;
      letter-spacing: 0.08em;
      text-transform: uppercase;
      color: var(--color-text-subtle);
      white-space: nowrap;
    }

    td {
      font-size: var(--text-sm);
      color: var(--color-text);
    }

    tbody tr:last-child th,
    tbody tr:last-child td {
      border-bottom: none;
    }
  }

  @media (max-width: 860px) {
    .ladder__link {
      grid-template-columns: 1fr;
      gap: var(--space-md);
    }

    .ladder__meta {
      padding-left: 0;
      padding-top: var(--space-md);
      border-left: none;
      border-top: 1px solid var(--color-border);
      width: 100%;
    }
  }
</style>
