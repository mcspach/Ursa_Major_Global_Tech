---
// The Big Dipper asterism: seven stars, six segments plus the bowl close.
// Used in the intro curtain, the header brand mark, and the footer.
const { class: className = "", starClass = "cstar", lineClass = "cline" } = Astro.props;
---

<svg
  class={className}
  viewBox="0 0 240 130"
  fill="none"
  xmlns="http://www.w3.org/2000/svg"
  aria-hidden="true"
>
  <path
    class={lineClass}
    d="M14 102 L58 76 L96 60 L134 50 L148 92 L210 98 L221 44 L134 50"
    stroke="currentColor"
    stroke-width="1"
  />
  <circle class={starClass} cx="14" cy="102" r="3.2"></circle>
  <circle class={starClass} cx="58" cy="76" r="2.6"></circle>
  <circle class={starClass} cx="96" cy="60" r="2.8"></circle>
  <circle class={starClass} cx="134" cy="50" r="2.4"></circle>
  <circle class={starClass} cx="148" cy="92" r="2.8"></circle>
  <circle class={starClass} cx="210" cy="98" r="3"></circle>
  <circle class={starClass} cx="221" cy="44" r="3.4"></circle>
</svg>
