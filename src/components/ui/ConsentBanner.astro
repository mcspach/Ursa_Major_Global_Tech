---
import { withBase } from "../../utils/paths";

/**
 * Cookie consent for visitors whose time zone reads as European. Whether to
 * show it, and what each choice does, is decided by the head script in
 * BaseLayout.astro (window.umConsent); this file is only the UI.
 *
 * Accept and Decline carry equal weight on purpose. UK and EU regulators
 * treat a dimmer "reject" button as steering, and steered consent isn't valid.
 *
 * Any element with [data-consent-open] reopens the banner, which is how the
 * footer's "Cookie settings" lets a visitor change their mind.
 */
---

<div class="consent" role="region" aria-label="Cookie consent" hidden data-consent>
  <p class="consent__text">
    We'd like to use analytics cookies (Google Analytics and Microsoft Clarity)
    to see how the site is used. Nothing loads unless you accept.
    <a href={withBase("/privacy/")}>Privacy policy</a>
  </p>
  <div class="consent__actions">
    <button type="button" class="btn btn--ghost consent__btn" data-consent-choice="denied">
      Decline
    </button>
    <button type="button" class="btn btn--ghost consent__btn" data-consent-choice="granted">
      Accept
    </button>
  </div>
</div>

<script>
  type Choice = "granted" | "denied";
  type Consent = {
    needsConsent: boolean;
    stored: string | null;
    set: (choice: Choice) => void;
  };

  const banner = document.querySelector<HTMLElement>("[data-consent]");
  const consent = (window as Window & { umConsent?: Consent }).umConsent;

  if (banner && consent) {
    if (consent.needsConsent && !consent.stored) banner.hidden = false;

    banner.addEventListener("click", (event) => {
      const button = (event.target as Element).closest<HTMLElement>("[data-consent-choice]");
      if (!button) return;
      consent.set(button.dataset.consentChoice as Choice);
      banner.hidden = true;
    });

    document.addEventListener("click", (event) => {
      if (!(event.target as Element).closest("[data-consent-open]")) return;
      event.preventDefault();
      banner.hidden = false;
      banner.querySelector<HTMLButtonElement>("[data-consent-choice]")?.focus();
    });
  }
</script>

<style lang="scss">
  /* Below the page-transition curtain (9999) so the intro still covers it,
     above the header (9000) and its mobile menu. */
  .consent {
    position: fixed;
    inset-inline: var(--space-md);
    bottom: var(--space-md);
    z-index: 9500;
    display: flex;
    align-items: center;
    gap: var(--space-md);
    max-width: 52rem;
    margin-inline: auto;
    padding: var(--space-sm) var(--space-md);
    border: 1px solid var(--color-border-strong);
    border-radius: var(--radius-md);
    background: var(--ink-850);
    box-shadow: 0 1.25rem 3rem rgba(0, 0, 0, 0.45);

    &[hidden] {
      display: none;
    }
  }

  .consent__text {
    flex: 1;
    font-size: var(--text-sm);
    line-height: 1.55;
    color: var(--color-text);

    a {
      color: var(--color-link);
      text-decoration: underline;
      text-underline-offset: 3px;

      &:hover {
        color: var(--color-link-strong);
      }
    }
  }

  .consent__actions {
    display: flex;
    flex-shrink: 0;
    gap: var(--space-xs);
  }

  .consent__btn {
    padding: 0.6rem 1.2rem;
    font-size: var(--text-sm);
  }

  @media (max-width: 640px) {
    .consent {
      flex-direction: column;
      align-items: stretch;
    }

    .consent__actions {
      justify-content: flex-end;
    }
  }
</style>
