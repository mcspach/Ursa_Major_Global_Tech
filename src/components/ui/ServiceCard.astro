---
import { withBase } from "../../utils/paths";

const { service, index = 0 } = Astro.props;
const { title, summary, priceLabel, timeline, deliverables } = service.data;

const shown = deliverables.slice(0, 3);
const remaining = deliverables.length - shown.length;
const number = String(index + 1).padStart(2, "0");
---

<article class="card service-card">
  <div class="service-card__visual">
    <span class="service-card__number">{number}</span>
    <h3 class="service-card__title">{title}</h3>
  </div>

  <div class="service-card__body">
    <p class="service-card__summary">{summary}</p>

    {
      shown.length > 0 && (
        <div class="service-card__deliverables">
          <p class="service-card__label">Key Deliverables:</p>
          <ul class="checklist">
            {shown.map((item) => (
              <li>{item}</li>
            ))}
          </ul>
          {remaining > 0 && <p class="service-card__more">+ {remaining} more…</p>}
        </div>
      )
    }

    <div class="service-card__meta">
      {
        priceLabel && (
          <div>
            <p class="service-card__meta-label">Pricing</p>
            <p class="service-card__meta-value">{priceLabel}</p>
          </div>
        )
      }
      <div>
        <p class="service-card__meta-label">Timeline</p>
        <p class="service-card__meta-value">{timeline}</p>
      </div>
    </div>

    <div class="service-card__actions">
      <a href={withBase(`/services/${service.id}/`)} class="btn btn--ghost">See More</a>
      <a href={withBase("/contact/")} class="btn btn--primary">Get Started</a>
    </div>
  </div>
</article>

<style lang="scss">
  .service-card {
    height: 100%;
  }

  .service-card__visual {
    position: relative;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    gap: 0.25rem;
    min-height: 9.5rem;
    padding: var(--space-md);
    background:
      radial-gradient(120% 140% at 85% 0%, rgba(109, 92, 245, 0.22) 0%, transparent 55%),
      radial-gradient(100% 120% at 15% 100%, rgba(139, 147, 214, 0.16) 0%, transparent 60%),
      var(--ink-700);
    border-bottom: 1px solid var(--color-border);
    overflow: hidden;
  }

  .service-card__number {
    position: absolute;
    top: 0.35rem;
    right: 1rem;
    font-family: var(--font-display);
    font-size: 5.5rem;
    font-weight: 600;
    line-height: 1;
    color: transparent;
    -webkit-text-stroke: 1px rgba(165, 175, 251, 0.22);
  }

  .service-card__title {
    font-size: var(--text-xl);
    position: relative;
  }

  .service-card__body {
    display: flex;
    flex-direction: column;
    gap: var(--space-md);
    padding: var(--space-md);
    flex: 1;
  }

  .service-card__summary {
    font-size: var(--text-sm);
    color: var(--color-text-muted);
  }

  .service-card__label {
    font-weight: 620;
    font-size: var(--text-sm);
    color: var(--color-text-strong);
    margin-bottom: 0.75rem;
  }

  .service-card__deliverables {
    :global(.checklist li) {
      font-size: var(--text-sm);
    }
  }

  .service-card__more {
    margin-top: 0.625rem;
    padding-left: 1.75rem;
    font-size: var(--text-sm);
    color: var(--color-text-subtle);
  }

  .service-card__meta {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-sm);
    padding-top: var(--space-sm);
    border-top: 1px solid var(--color-border);
    margin-top: auto;
  }

  .service-card__meta-label {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-text-subtle);
    margin-bottom: 0.25rem;
  }

  .service-card__meta-value {
    font-family: var(--font-display);
    font-size: var(--text-md);
    font-weight: 570;
    color: var(--color-text-strong);
  }

  .service-card__actions {
    display: flex;
    gap: 0.75rem;
    flex-wrap: wrap;

    .btn {
      flex: 1;
      z-index: 2;
    }
  }
</style>
