---
import { withBase } from "../../utils/paths";
import { readingTime } from "../../utils/reading";

const { post } = Astro.props;
const { title, description, category, pubDate } = post.data;

const readTime = post.data.readTime ?? readingTime(post.body);

const formattedDate = pubDate.toLocaleDateString("en-US", {
  month: "short",
  day: "numeric",
  year: "numeric",
  timeZone: "UTC",
});

// Each category gets its own gradient hue for the banner.
const CATEGORY_HUES = {
  Architecture: 236,
  MVP: 262,
  "Vibe Coding Tools": 288,
  Process: 214,
  Automation: 250,
  Strategy: 276,
};

const hue = CATEGORY_HUES[category] ?? 248;
---

<article class="card post-card">
  <a
    class="post-card__link"
    href={withBase(`/blog/${post.id}/`)}
    aria-label={`${title} — read post`}></a>

  <div class="post-card__banner" style={`--hue: ${hue}`}>
    <span class="post-card__banner-mark">✦</span>
    <span class="post-card__banner-category">{category}</span>
  </div>

  <div class="post-card__body">
    <h3 class="post-card__title">{title}</h3>
    <p class="post-card__description">{description}</p>
    <div class="post-card__meta">
      <span>{formattedDate}</span>
      <span aria-hidden="true">·</span>
      <span>{readTime}</span>
    </div>
  </div>
</article>

<style lang="scss">
  .post-card {
    height: 100%;
  }

  .post-card__link {
    position: absolute;
    inset: 0;
    z-index: 2;
  }

  .post-card__banner {
    position: relative;
    display: flex;
    align-items: flex-end;
    gap: 0.625rem;
    min-height: 7.5rem;
    padding: var(--space-md);
    background:
      radial-gradient(
        130% 160% at 80% -20%,
        hsla(var(--hue), 70%, 65%, 0.28) 0%,
        transparent 60%
      ),
      radial-gradient(
        100% 130% at 10% 110%,
        hsla(calc(var(--hue) + 30), 60%, 55%, 0.16) 0%,
        transparent 55%
      ),
      var(--ink-700);
    border-bottom: 1px solid var(--color-border);
  }

  .post-card__banner-mark {
    color: hsla(var(--hue), 80%, 75%, 0.9);
    font-size: 1rem;
  }

  .post-card__banner-category {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--color-text-strong);
  }

  .post-card__body {
    display: flex;
    flex-direction: column;
    gap: 0.625rem;
    padding: var(--space-md);
    flex: 1;
  }

  .post-card__title {
    font-size: var(--text-lg);
    line-height: 1.2;
  }

  .post-card__description {
    font-size: var(--text-sm);
    color: var(--color-text-muted);
    flex: 1;

    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .post-card__meta {
    display: flex;
    gap: 0.5rem;
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    color: var(--color-text-subtle);
  }
</style>
