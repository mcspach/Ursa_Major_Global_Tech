---
import { withBase } from "../../utils/paths";
import Wordmark from "../ui/Wordmark.astro";

const year = new Date().getFullYear();

const QUICK_LINKS = [
  { label: "Services", href: "/services/" },
  { label: "Advisory", href: "/advisory/" },
  { label: "Blog", href: "/blog/" },
  { label: "About", href: "/about/" },
  { label: "Products", href: "/products/" },
];
---

<footer class="site-footer">
  <div class="container container--wide">
    <div class="site-footer__grid">
      <div class="site-footer__brand">
        <a href={withBase("/")} class="site-footer__brand-link" aria-label="Ursa Major Global Tech, home">
          <Wordmark />
        </a>
        <p class="site-footer__tagline">Bringing Frontier AI down to earth.</p>
        <p class="site-footer__blurb">
          We build MVPs, SaaS platforms, and custom applications with AI-accelerated
          development. Production-ready software, shipped in weeks.
        </p>
      </div>

      <nav class="site-footer__col" aria-label="Quick links">
        <h2 class="site-footer__heading">Quick Links</h2>
        <ul>
          {
            QUICK_LINKS.map((link) => (
              <li>
                <a href={withBase(link.href)}>{link.label}</a>
              </li>
            ))
          }
        </ul>
      </nav>

      <div class="site-footer__col">
        <h2 class="site-footer__heading">Contact</h2>
        <ul>
          <li><a href="mailto:hello@ursamajorglobaltech.com">hello@ursamajorglobaltech.com</a></li>
          <li><a href={withBase("/contact/")}>Contact Us</a></li>
        </ul>
      </div>
    </div>

    <div class="site-footer__bottom">
      <p>© {year} Ursa Major Global Tech</p>
    </div>
  </div>
</footer>

<style lang="scss">
  .site-footer {
    position: relative;
    background: var(--color-bg-deep);
    border-top: 1px solid var(--color-border);
    padding-block: var(--space-2xl) var(--space-lg);
    overflow: hidden;
  }

  .site-footer__grid {
    display: grid;
    grid-template-columns: minmax(0, 1.6fr) minmax(0, 1fr) minmax(0, 1fr);
    gap: var(--space-xl);
  }

  .site-footer__brand-link {
    display: inline-flex;
    align-items: center;
    gap: 0.875rem;
  }

  .site-footer__tagline {
    margin-top: var(--space-md);
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--peri-400);
  }

  .site-footer__blurb {
    margin-top: var(--space-sm);
    max-width: 34ch;
    font-size: var(--text-sm);
    color: var(--color-text-subtle);
  }

  .site-footer__heading {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    font-weight: 500;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--color-text-strong);
    margin-bottom: var(--space-md);
  }

  .site-footer__col ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 0.75rem;

    a {
      font-size: var(--text-sm);
      color: var(--color-text-muted);

      &:hover {
        color: var(--color-link);
      }
    }
  }

  .site-footer__bottom {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-sm);
    margin-top: var(--space-2xl);
    padding-top: var(--space-lg);
    border-top: 1px solid var(--color-border);

    p {
      font-family: var(--font-mono);
      font-size: var(--text-xs);
      color: var(--color-text-subtle);
    }
  }

  @media (max-width: 800px) {
    .site-footer__grid {
      grid-template-columns: 1fr;
      gap: var(--space-lg);
    }

    .site-footer__bottom {
      flex-direction: column;
      align-items: flex-start;
    }
  }
</style>
