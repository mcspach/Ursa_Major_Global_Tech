---
import { withBase } from "../../utils/paths";
---

<section class="hero">
  <canvas class="hero__canvas" data-constellation aria-hidden="true"></canvas>
  <div class="hero__glow" aria-hidden="true"></div>

  <div class="container hero__inner">
    <p class="eyebrow" data-animate="fade" data-animate-delay="0.9">
      AI Automation &amp; Custom Software
    </p>

    <h1 class="hero__title" data-split="lines" data-split-delay="0.15">
      Frontier AI<br/> brought down to earth.
    </h1>

    <p class="hero__lead" data-animate="fade-up" data-animate-delay="1.05">
      Workflow automation, custom applications, and AI systems that run in
      production — not in a sandbox. Built by a small senior team, shipped in
      weeks, and yours end to end.
    </p>

    <div class="hero__actions" data-animate="fade-up" data-animate-delay="1.2">
      <a href={withBase("/products/")} class="btn btn--primary btn--lg">
        View Our Work <span class="btn__arrow">→</span>
      </a>
      <a href={withBase("/contact/")} class="btn btn--ghost btn--lg">
        Book a Discovery Call
      </a>
    </div>
  </div>

</section>

<style lang="scss">
  .hero {
    position: relative;
    min-height: 100svh;
    display: flex;
    align-items: center;
    overflow: hidden;
  }

  .hero__canvas {
    position: absolute;
    /* Extra vertical headroom so the parallax shift never reveals an edge. */
    top: -20%;
    left: 0;
    width: 100%;
    height: 140%;
    will-change: transform;
  }

  .hero__glow {
    position: absolute;
    inset: 0;
    pointer-events: none;
    background:
      radial-gradient(
        55% 60% at 50% 32%,
        rgba(109, 92, 245, 0.14) 0%,
        transparent 70%
      ),
      radial-gradient(
        40% 45% at 68% 20%,
        rgba(139, 147, 214, 0.1) 0%,
        transparent 65%
      );
  }

  .hero__inner {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: var(--space-md);
    padding-block: calc(var(--header-height) + var(--space-xl)) var(--space-xl);
  }

  .hero__title {
    max-width: 14ch;
    font-size: var(--text-hero);
    font-weight: 570;

    /* Gradient is applied per split line so background-clip survives the
       SplitType wrappers; the fallback covers the pre-split state. */
    background: var(--gradient-headline);
    background-clip: text;
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;

    /* Once split, the lines paint their own gradient. The parent's clipped
       background must go away: Chrome renders it as a static ghost copy
       because background-clip: text ignores descendant transforms. */
    &:global(.is-split) {
      background: none;
    }

    :global(.line) {
      background: var(--gradient-headline);
      background-clip: text;
      -webkit-background-clip: text;
      -webkit-text-fill-color: transparent;
    }
  }

  .hero__lead {
    max-width: 36rem;
    font-size: var(--text-md);
    color: var(--color-text-muted);
    text-wrap: pretty;
  }

  .hero__actions {
    display: flex;
    gap: var(--space-sm);
    flex-wrap: wrap;
    justify-content: center;
    margin-top: var(--space-sm);
  }

</style>
