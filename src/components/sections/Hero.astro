---
import { withBase } from "../../utils/paths";
---

<section class="hero">
  <canvas class="hero__canvas" data-constellation aria-hidden="true"></canvas>
  <div class="hero__glow" aria-hidden="true"></div>

  <div class="container hero__inner">
    <p class="eyebrow" data-animate="fade" data-animate-delay="0.9">
      AI-Accelerated Software Studio
    </p>

    <h1 class="hero__title" data-split="lines" data-split-delay="0.15">
      Coding at the Speed of Thought
    </h1>

    <p class="hero__lead" data-animate="fade-up" data-animate-delay="1.05">
      We build production-ready software, AI automation systems, and white-label
      products. What takes most teams months takes us days.
    </p>

    <div class="hero__actions" data-animate="fade-up" data-animate-delay="1.2">
      <a href={withBase("/products/")} class="btn btn--primary btn--lg">
        View Our Work <span class="btn__arrow">→</span>
      </a>
      <a href={withBase("/contact/")} class="btn btn--ghost btn--lg">
        Book a Discovery Call
      </a>
    </div>
  </div>

  <div class="hero__scroll-hint" data-animate="fade" data-animate-delay="1.8" aria-hidden="true">
    <span class="hero__scroll-line"></span>
    <span class="hero__scroll-label">Scroll</span>
  </div>
</section>

<style lang="scss">
  .hero {
    position: relative;
    min-height: 100svh;
    display: flex;
    align-items: center;
    overflow: hidden;
  }

  .hero__canvas {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }

  .hero__glow {
    position: absolute;
    inset: 0;
    pointer-events: none;
    background:
      radial-gradient(
        55% 60% at 50% 32%,
        rgba(139, 92, 246, 0.14) 0%,
        transparent 70%
      ),
      radial-gradient(
        40% 45% at 68% 20%,
        rgba(139, 147, 214, 0.1) 0%,
        transparent 65%
      );
  }

  .hero__inner {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: var(--space-md);
    padding-block: calc(var(--header-height) + var(--space-xl)) var(--space-xl);
  }

  .hero__title {
    max-width: 14ch;
    font-size: var(--text-hero);
    font-weight: 570;

    /* Gradient is applied per split line so background-clip survives the
       SplitType wrappers; the fallback covers the pre-split state. */
    background: var(--gradient-headline);
    background-clip: text;
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;

    /* Once split, the lines paint their own gradient. The parent's clipped
       background must go away: Chrome renders it as a static ghost copy
       because background-clip: text ignores descendant transforms. */
    &:global(.is-split) {
      background: none;
    }

    :global(.line) {
      background: var(--gradient-headline);
      background-clip: text;
      -webkit-background-clip: text;
      -webkit-text-fill-color: transparent;
    }
  }

  .hero__lead {
    max-width: 36rem;
    font-size: var(--text-md);
    color: var(--color-text-muted);
    text-wrap: pretty;
  }

  .hero__actions {
    display: flex;
    gap: var(--space-sm);
    flex-wrap: wrap;
    justify-content: center;
    margin-top: var(--space-sm);
  }

  .hero__scroll-hint {
    position: absolute;
    bottom: 2rem;
    left: 50%;
    transform: translateX(-50%);
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.625rem;
  }

  .hero__scroll-line {
    display: block;
    width: 1px;
    height: 2.75rem;
    background: linear-gradient(to bottom, transparent, var(--peri-400));
    animation: um-scroll-pulse 2.2s ease-in-out infinite;
  }

  .hero__scroll-label {
    font-family: var(--font-mono);
    font-size: 0.6rem;
    letter-spacing: 0.3em;
    text-transform: uppercase;
    color: var(--color-text-subtle);
  }

  @keyframes um-scroll-pulse {
    0%,
    100% {
      opacity: 0.35;
      transform: scaleY(0.7);
      transform-origin: top;
    }
    50% {
      opacity: 1;
      transform: scaleY(1);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero__scroll-line {
      animation: none;
    }
  }
</style>
