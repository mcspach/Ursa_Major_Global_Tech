---
// Placeholder numbers. Swap for real figures before launch.
const STATS = [
  { value: 40, suffix: "+", label: "Clients served" },
  { value: 12, suffix: "", label: "Apps in production" },
  { value: 4, suffix: " wks", label: "Average idea-to-launch" },
  { value: 100, suffix: "%", label: "Source code ownership" },
];
---

<section class="section section--sm">
  <div class="container">
    <dl class="stats" data-animate-children>
      {
        STATS.map((stat) => (
          <div class="stats__item">
            <dd class="stats__value">
              <span data-counter data-target={stat.value}>{stat.value}</span
              ><span class="stats__suffix">{stat.suffix}</span>
            </dd>
            <dt class="stats__label">{stat.label}</dt>
          </div>
        ))
      }
    </dl>
  </div>
</section>

<style lang="scss">
  .stats {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: var(--space-lg);
    margin: 0;
  }

  .stats__item {
    display: flex;
    flex-direction: column-reverse;
    gap: 0.375rem;
    padding-left: var(--space-md);
    border-left: 1px solid var(--color-border-strong);
  }

  .stats__value {
    font-family: var(--font-display);
    font-size: var(--text-2xl);
    font-weight: 590;
    color: var(--blue-400);
    line-height: 1;
  }

  .stats__suffix {
    color: var(--color-link);
  }

  .stats__label {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--color-text);
  }

  @media (max-width: 800px) {
    .stats {
      grid-template-columns: repeat(2, 1fr);
      gap: var(--space-md);
    }
  }
</style>
