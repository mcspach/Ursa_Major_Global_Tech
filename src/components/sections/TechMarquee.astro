---
const TOOLS = [
  "Claude Code",
  "Supabase",
  "GitHub",
  "n8n",
  "Make",
  "Gumloop",
  "Vercel",
  "React",
  "Next.js",
  "Astro",
  "Stripe",
  "Lovable",
];

// The track is rendered twice so the -50% loop is seamless.
const loop = [TOOLS, TOOLS];
---

<div class="marquee" data-marquee data-marquee-duration="30">
  <p class="visually-hidden">
    Our stack: {TOOLS.join(", ")}
  </p>
  <div class="marquee__track" data-marquee-track aria-hidden="true">
    {
      loop.map((tools) => (
        <div class="marquee__group">
          {tools.map((tool) => (
            <span class="marquee__item">
              {tool}
              <span class="marquee__star">✦</span>
            </span>
          ))}
        </div>
      ))
    }
  </div>
</div>

<style lang="scss">
  .marquee {
    position: relative;
    padding-block: var(--space-md);
    border-block: 1px solid var(--color-border);
    overflow: hidden;
    /* Stated rather than inherited. The track's colour only means anything
       against a known ground, and a contrast checker walking up for a
       background-color otherwise finds transparency all the way to <body>
       and has nothing to compare against. */
    background: var(--color-bg);
  }

  /**
   * Edge fade, painted over the track instead of masking it.
   *
   * This was `mask-image`, which multiplies the track's own alpha: the text
   * really did render semi-transparent across the outer 12%, measuring as low
   * as 1.1:1 against the page even though the label itself is 9.07:1. A
   * deliberate fade, but indistinguishable from a contrast failure to anything
   * inspecting it. Two opaque-to-transparent overlays give the same result
   * visually while the text underneath stays fully opaque at every point.
   */
  .marquee::before,
  .marquee::after {
    content: "";
    position: absolute;
    top: 0;
    bottom: 0;
    width: 12%;
    pointer-events: none;
    z-index: 1;
  }

  .marquee::before {
    left: 0;
    background: linear-gradient(to right, var(--color-bg), transparent);
  }

  .marquee::after {
    right: 0;
    background: linear-gradient(to left, var(--color-bg), transparent);
  }

  .marquee__track {
    display: flex;
    width: max-content;
    will-change: transform;
  }

  .marquee__group {
    display: flex;
    flex-shrink: 0;
  }

  .marquee__item {
    display: inline-flex;
    align-items: center;
    gap: 2.25rem;
    padding-right: 2.25rem;
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    font-weight: 500;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: var(--color-text);
    white-space: nowrap;
    transition: color var(--transition-base);

    &:hover {
      color: var(--peri-300);
    }
  }

  .marquee__star {
    font-size: 0.6rem;
    /* Was rgba(109, 92, 245, 0.6), which composites to 2.21:1 on the page.
       Decorative, and inside an aria-hidden subtree, but a 0.6rem glyph at
       that ratio is the sort of thing a checker flags and a person squints
       at. peri-500 reads 6.64:1 and stays as quiet in the layout. */
    color: var(--peri-500);
  }
</style>
