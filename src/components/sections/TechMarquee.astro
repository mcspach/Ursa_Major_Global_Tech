---
const TOOLS = [
  "Claude Code",
  "Supabase",
  "GitHub",
  "n8n",
  "Make",
  "Gumloop",
  "Vercel",
  "React",
  "Next.js",
  "Astro",
  "Stripe",
  "Lovable",
];

// The track is rendered twice so the -50% loop is seamless.
const loop = [TOOLS, TOOLS];
---

<div class="marquee" data-marquee data-marquee-duration="30">
  <p class="visually-hidden">
    Our stack: {TOOLS.join(", ")}
  </p>
  <div class="marquee__track" data-marquee-track aria-hidden="true">
    {
      loop.map((tools) => (
        <div class="marquee__group">
          {tools.map((tool) => (
            <span class="marquee__item">
              {tool}
              <span class="marquee__star">✦</span>
            </span>
          ))}
        </div>
      ))
    }
  </div>
</div>

<style lang="scss">
  .marquee {
    position: relative;
    padding-block: var(--space-md);
    border-block: 1px solid var(--color-border);
    overflow: hidden;

    /* Soft fade at the edges */
    mask-image: linear-gradient(
      to right,
      transparent 0%,
      black 12%,
      black 88%,
      transparent 100%
    );
  }

  .marquee__track {
    display: flex;
    width: max-content;
    will-change: transform;
  }

  .marquee__group {
    display: flex;
    flex-shrink: 0;
  }

  .marquee__item {
    display: inline-flex;
    align-items: center;
    gap: 2.25rem;
    padding-right: 2.25rem;
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    font-weight: 500;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: var(--color-text-subtle);
    white-space: nowrap;
    transition: color var(--transition-base);

    &:hover {
      color: var(--peri-300);
    }
  }

  .marquee__star {
    font-size: 0.6rem;
    color: rgba(139, 92, 246, 0.6);
  }
</style>
