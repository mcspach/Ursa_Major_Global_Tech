---
import "../styles/global.scss";

import Grain from "../components/sections/Grain.astro";
import Header from "../components/sections/Header.astro";
import Footer from "../components/sections/Footer.astro";
import ConstellationMark from "../components/ui/ConstellationMark.astro";
import { toAbsoluteUrl, withBase } from "../utils/paths";
import {
  breadcrumbs,
  organization,
  orgId,
  webPage,
  website,
} from "../utils/schema";

const SITE_NAME = "Ursa Major Global Tech";
const DEFAULT_TITLE = "Ursa Major Global Tech | AI Automation & Custom Software";
const DEFAULT_DESCRIPTION =
  "We build production-ready software, AI automation systems, and white-label products. What takes most teams months takes us days.";
const DEFAULT_SOCIAL_IMAGE_PATH = "/og_image.png";
const THEME_COLOR = "#0a0e1a";

const {
  title = DEFAULT_TITLE,
  description = DEFAULT_DESCRIPTION,
  canonicalPath = "/",
  socialImagePath = DEFAULT_SOCIAL_IMAGE_PATH,
  ogType = "website",
  noindex = false,
  // Structured data. Pages pass only the nodes specific to them; Organization,
  // WebSite, WebPage, and BreadcrumbList are added here so every page carries
  // them and the breadcrumb trail can't drift from the canonical URL.
  schema = [],
  // WebPage name and the final breadcrumb. Defaults to the <title> with the
  // site-name suffix trimmed off.
  pageName,
  // Overrides the WebPage @type: AboutPage, ContactPage, CollectionPage…
  pageType = "WebPage",
  // The primary entity the page is about, by @id.
  pageAbout,
} = Astro.props;

const siteUrl = Astro.site ?? new URL("https://www.ursamajorglobaltech.com");
const canonicalUrl = toAbsoluteUrl(canonicalPath, siteUrl);
const socialImageUrl = toAbsoluteUrl(socialImagePath, siteUrl);

const resolvedPageName =
  pageName ?? title.replace(new RegExp(`\\s*\\|\\s*${SITE_NAME}\\s*$`), "");

const trail = breadcrumbs(canonicalPath, siteUrl, resolvedPageName);

/**
 * One @graph per page. A noindex page gets none: structured data exists to be
 * indexed, so emitting it on a page we've asked crawlers to skip is noise at
 * best and a contradiction at worst.
 */
const graph = noindex
  ? null
  : [
      organization(siteUrl),
      website(siteUrl),
      webPage({
        path: canonicalPath,
        site: siteUrl,
        name: resolvedPageName,
        description,
        type: pageType,
        hasBreadcrumb: Boolean(trail),
        // The homepage and the about page are both about the studio itself.
        about:
          pageAbout ??
          (canonicalPath === "/" || pageType === "AboutPage"
            ? orgId(siteUrl)
            : undefined),
      }),
      ...(trail ? [trail] : []),
      ...schema.filter(Boolean),
    ];

const jsonLd = graph
  ? JSON.stringify({ "@context": "https://schema.org", "@graph": graph })
  : null;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content={THEME_COLOR} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}

    <link rel="canonical" href={canonicalUrl} />
    <link rel="icon" href={withBase("/favicon.svg")} type="image/svg+xml" />
    <link rel="sitemap" href={withBase("/sitemap-index.xml")} />

    <link
      rel="preload"
      href={withBase("/fonts/ClashDisplay-Variable.woff2")}
      as="font"
      type="font/woff2"
      crossorigin
    />
    <link
      rel="preload"
      href={withBase("/fonts/Satoshi-Variable.woff2")}
      as="font"
      type="font/woff2"
      crossorigin
    />

    <meta property="og:site_name" content={SITE_NAME} />
    <meta property="og:locale" content="en_US" />
    <meta property="og:type" content={ogType} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={socialImageUrl} />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={socialImageUrl} />

    <script is:inline>
      (() => {
        const root = document.documentElement;
        const reduced =
          window.matchMedia?.("(prefers-reduced-motion: reduce)").matches ?? false;

        if (!reduced) {
          root.classList.add("um-js");
        }

        try {
          if (window.sessionStorage.getItem("um:navCover") === "true") {
            root.classList.add("um-nav-boot");
          } else if (
            !reduced &&
            window.sessionStorage.getItem("um:hasSeenIntro") !== "true"
          ) {
            root.classList.add("um-intro-boot");
          }
        } catch {
          // Storage unavailable, so boot uncovered.
        }

        // If the motion module never boots, force-reveal all hidden content.
        window.setTimeout(() => root.classList.add("um-anim-failsafe"), 3200);
      })();
    </script>

    {jsonLd && (
      <script type="application/ld+json" is:inline set:html={jsonLd} />
    )}

    {/* Per-page additions. */}
    <slot name="head" />
  </head>
  <body>
    <div class="site-transition" data-site-transition aria-hidden="true">
      <div class="site-transition__mark">
        <ConstellationMark class="site-transition__constellation" />
        <span class="site-transition__wordmark">Ursa Major Global Tech</span>
      </div>
    </div>

    <Header />

    <div id="site-root">
      <main class="site-main">
        <slot />
      </main>
      <Footer />
    </div>

    <Grain />

    <script>
      import "../scripts/transitions.js";
      import "../scripts/motion.js";
    </script>
  </body>
</html>
